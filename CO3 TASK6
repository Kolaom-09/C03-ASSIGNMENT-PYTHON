# Build station index
station_index = {}

for train_no, details in timetable.items():
    for station, arrival, departure in details["stops"]:
        station_index.setdefault(station, []).append(train_no)

# Search trains
def find_trains(station, day):
    result = []

    for train_no, details in timetable.items():
        if day not in details["days"]:
            continue

        for stop in details["stops"]:
            if stop[0] == station:
                result.append(
                    (train_no, details["name"], stop[2])
                )
                break

    return sorted(result, key=lambda x: x[2])

print("Trains stopping at Chennai on Monday:")

for train in find_trains("Chennai", "Monday"):
    print(train)

# Search using station index
def indexed_search(station, day):
    result = []

    for train_no in station_index.get(station, []):
        details = timetable[train_no]

        if day in details["days"]:
            for stop in details["stops"]:
                if stop[0] == station:
                    result.append(
                        (train_no, details["name"], stop[2])
                    )
                    break

    return sorted(result, key=lambda x: x[2])

print("\nUsing station index:")
print(indexed_search("Chennai", "Monday"))

