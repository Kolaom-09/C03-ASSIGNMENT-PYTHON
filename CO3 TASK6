# Performance testing
for n in [100, 1000, 10000]:
    generated = {}

    for i in range(n):
        generated[str(i)] = {
            "name": "Train" + str(i),
            "stops": [
                ("Chennai", "06:00", "06:10"),
                ("Katpadi", "08:00", "08:10")
            ],
            "days": {"Monday", "Friday"}
        }

    index = {}

    for train_no, details in generated.items():
        for station, arrival, departure in details["stops"]:
            index.setdefault(station, []).append(train_no)

    start = time.perf_counter()

    for train_no, details in generated.items():
        for stop in details["stops"]:
            if stop[0] == "Chennai":
                break

    normal_time = time.perf_counter() - start

    start = time.perf_counter()

    for train_no in index.get("Chennai", []):
        generated[train_no]

    indexed_time = time.perf_counter() - start

    print("\nNumber of trains:", n)
    print("Without index:", normal_time)
    print("With index:", indexed_time)

print("\nIndex memory:",
