# Performance testing
for n in [1000, 100000]:
    test_data = []

    for i in range(n):
        test_data.append({
            "name": "Person" + str(i),
            "phone": str(9000000000 + i),
            "email": "person" + str(i) + "@gmail.com"
        })

    start = time.perf_counter()
    merged = merge_contacts(test_data)
    elapsed = time.perf_counter() - start

    print("\nContacts:", n)
    print("Dictionary merging time:", elapsed)
    print("Unique contacts:", len(merged))

